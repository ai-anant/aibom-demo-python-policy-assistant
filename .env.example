# Local overrides - copy to .env and export as needed.
# The service runs fully offline with AI_PROVIDER=stub (the default when no key is set).

AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
CHAT_MODEL=gpt-4o-mini
ESCALATION_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Use the local sentence-transformers model instead of OpenAI embeddings
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# memory | chroma
VECTOR_STORE=memory
KB_COLLECTION=policy-kb

# Local Hugging Face models (downloads weights on first run)
HF_LOCAL_MODELS=false
HF_DEVICE=cpu
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_TOPIC_MODEL=facebook/bart-large-mnli
HF_TOXICITY_MODEL=unitary/toxic-bert
RERANK_TOP_N=3
TOXICITY_THRESHOLD=0.75

TEMPERATURE=0.1
MAX_TOKENS=800
TOP_K=4
REDACT_PII=true
PORT=8080
